import json
import urllib.error
import urllib.request
from typing import Any, Dict, Optional
from pydantic import BaseModel, Field


class Tools:
    class Valves(BaseModel):
        GODOT_BRIDGE_URL: str = Field(
            default="http://192.168.1.99:9090",
            description="Base HTTP URL where the Godot Bridge plugin server is listening.",
        )
        AUTH_TOKEN: str = Field(
            default="",
            description="Bearer token from the Godot Bridge dock. Set it here in Valves, not in code.",
        )
        TIMEOUT_SECONDS: int = Field(
            default=10,
            description="HTTP timeout for each bridge call.",
        )

    def __init__(self):
        self.valves = self.Valves()

    # ------------------------------------------------------------------
    # Internal helpers (underscore names are NOT exposed as tools)
    # ------------------------------------------------------------------

    def _send_command(
        self, command: str, payload: Optional[Dict[str, Any]] = None
    ) -> str:
        """Send a command to the Godot Bridge and return the raw JSON reply."""
        url = self.valves.GODOT_BRIDGE_URL.rstrip("/")
        data = json.dumps({"command": command, "payload": payload or {}}).encode(
            "utf-8"
        )

        headers = {"Content-Type": "application/json; charset=utf-8"}
        token = self.valves.AUTH_TOKEN.strip()
        if token:
            headers["Authorization"] = f"Bearer {token}"

        req = urllib.request.Request(url, data=data, headers=headers, method="POST")

        try:
            with urllib.request.urlopen(
                req, timeout=self.valves.TIMEOUT_SECONDS
            ) as response:
                return response.read().decode("utf-8")
        except urllib.error.HTTPError as e:
            try:
                return e.read().decode("utf-8")
            except Exception:
                return json.dumps(
                    {"ok": False, "error": f"HTTP Error {e.code}: {e.reason}"}
                )
        except urllib.error.URLError as e:
            return json.dumps(
                {
                    "ok": False,
                    "error": f"Connection error: {e.reason}. Ensure Godot is running with Godot Bridge active.",
                }
            )
        except Exception as e:
            return json.dumps({"ok": False, "error": str(e)})

    @staticmethod
    def _parse_value(value: Any) -> Any:
        """Accept JSON text like '[100, 200]' or 'true' and turn it into real JSON values."""
        if isinstance(value, str):
            try:
                return json.loads(value)
            except (ValueError, TypeError):
                return value
        return value

    # ------------------------------------------------------------------
    # Discovery
    # ------------------------------------------------------------------

    def ping(self) -> str:
        """
        Check the connection to Godot. Returns the project name and Godot version.
        """
        return self._send_command("ping")

    def get_commands(self) -> str:
        """
        List every bridge command and whether it is enabled (true) or disabled (false) in the Godot plugin.
        Call this if a tool returns 'Command disabled'.
        """
        return self._send_command("get_commands")

    # ------------------------------------------------------------------
    # Scene inspection (read-only)
    # ------------------------------------------------------------------

    def get_scene_tree(self) -> str:
        """
        Get the node hierarchy of the scene currently open in the Godot editor, with node names, types, and attached scripts.
        """
        return self._send_command("get_scene_tree")

    def get_selected_nodes(self) -> str:
        """
        Get the nodes currently selected in the open scene.
        """
        return self._send_command("get_selected_nodes")

    def get_node_properties(self, node_path: Optional[str] = None) -> str:
        """
        Get the inspector properties of a node.

        :param node_path: Node path relative to the scene root (e.g. 'Player' or 'World/Enemy'). Use '.' for the root. If omitted, uses the current selection.
        """
        payload = {}
        if node_path:
            payload["node_path"] = node_path
        return self._send_command("get_node_properties", payload)

    def get_node_signals(self, node_path: Optional[str] = None) -> str:
        """
        List the signals of a node and what each one is connected to.

        :param node_path: Node path relative to the scene root. If omitted, uses the current selection.
        """
        payload = {}
        if node_path:
            payload["node_path"] = node_path
        return self._send_command("get_node_signals", payload)

    # ------------------------------------------------------------------
    # Files (read_file and list_dir are read-only; write_file changes files)
    # ------------------------------------------------------------------

    def list_dir(self, path: str = "res://") -> str:
        """
        List files and folders inside a project directory.

        :param path: Directory path (defaults to 'res://').
        """
        return self._send_command("list_dir", {"path": path})

    def read_file(self, path: str) -> str:
        """
        Read the text contents of a file in the Godot project.

        :param path: File path, e.g. 'res://scripts/player.gd'.
        """
        return self._send_command("read_file", {"path": path})

    def get_open_script(self) -> str:
        """
        Get the path and full source of the script currently open in Godot's Script Editor.
        """
        return self._send_command("get_open_script")

    def write_file(self, path: str, content: str) -> str:
        """
        Replace the ENTIRE contents of a project file (creates it if missing). Always send the complete file, never a snippet. Read the file first.

        :param path: Target file path starting with res://.
        :param content: The complete new file text.
        """
        return self._send_command("write_file", {"path": path, "content": content})

    # ------------------------------------------------------------------
    # Scene editing (each is undoable in the editor; disabled by default in the plugin)
    # ------------------------------------------------------------------

    def set_node_property(
        self, property: str, value: str, node_path: Optional[str] = None
    ) -> str:
        """
        Set a property on a node.

        :param property: Property name, e.g. 'position', 'visible', 'modulate', 'text'.
        :param value: New value as JSON text: '[100, 200]' for Vector2, '[1, 0, 0, 1]' for Color, 'true', '42', or plain text for strings.
        :param node_path: Target node path relative to the scene root. If omitted, uses the current selection.
        """
        payload = {"property": property, "value": self._parse_value(value)}
        if node_path:
            payload["node_path"] = node_path
        return self._send_command("set_node_property", payload)

    def spawn_node(
        self,
        node_type: str,
        name: str = "NewNode",
        parent_node_path: str = ".",
    ) -> str:
        """
        Create a new node in the open scene.

        :param node_type: Godot class name, e.g. 'Sprite2D', 'Node2D', 'Label', 'CharacterBody2D', 'Timer'.
        :param name: Name for the new node.
        :param parent_node_path: Parent node path relative to the scene root. '.' means the scene root.
        """
        payload = {
            "node_type": node_type,
            "name": name,
            "parent": parent_node_path or ".",
        }
        return self._send_command("spawn_node", payload)

    def spawn_packed_scene(
        self,
        scene_path: str,
        name: str = "",
        parent_node_path: str = ".",
    ) -> str:
        """
        Instantiate a saved scene file (.tscn) into the open scene.

        :param scene_path: Scene file path, e.g. 'res://enemies/slime.tscn'.
        :param name: Optional name for the new instance.
        :param parent_node_path: Parent node path relative to the scene root. '.' means the scene root.
        """
        payload = {
            "scene_path": scene_path,
            "parent": parent_node_path or ".",
        }
        if name:
            payload["name"] = name
        return self._send_command("spawn_packed_scene", payload)

    def remove_node(self, node_path: str) -> str:
        """
        Delete a node from the open scene. The scene root cannot be removed.

        :param node_path: Path of the node to delete, relative to the scene root.
        """
        return self._send_command("remove_node", {"node_path": node_path})

    def reparent_node(self, node_path: str, new_parent_path: str) -> str:
        """
        Move a node under a different parent in the open scene.

        :param node_path: Path of the node to move.
        :param new_parent_path: Path of the new parent ('.' for the scene root).
        """
        return self._send_command(
            "reparent_node",
            {"target": node_path, "new_parent": new_parent_path},
        )

    def connect_signal(
        self,
        source_node_path: str,
        signal_name: str,
        target_node_path: str,
        method_name: str,
    ) -> str:
        """
        Connect a signal on one node to a method on another node.

        :param source_node_path: Node that emits the signal.
        :param signal_name: Signal name, e.g. 'pressed' or 'body_entered'.
        :param target_node_path: Node that receives the signal (must have the method).
        :param method_name: Method to call on the target node.
        """
        return self._send_command(
            "connect_signal",
            {
                "source": source_node_path,
                "signal": signal_name,
                "target": target_node_path,
                "method": method_name,
            },
        )

    # ------------------------------------------------------------------
    # Scene and project control (disabled by default in the plugin)
    # ------------------------------------------------------------------

    def save_scene(self) -> str:
        """
        Save the scene currently open in the editor.
        """
        return self._send_command("save_scene")

    def open_scene(self, path: str) -> str:
        """
        Open a scene file in the editor.

        :param path: Scene path, e.g. 'res://main.tscn'.
        """
        return self._send_command("open_scene", {"path": path})

    def run_project(self) -> str:
        """
        Run the project's main scene.
        """
        return self._send_command("run_project")

    def stop_project(self) -> str:
        """
        Stop the running project.
        """
        return self._send_command("stop_project")

